# ---- Database (Turso / libSQL) ---------------------------------------------
# Leave both unset for local dev — falls back to a local file (./local.db),
# no account needed. Set both to point at a hosted Turso DB (required in
# production on Vercel/Netlify — see README).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Admin ------------------------------------------------------------------
# The admin panel's URL path. Keep this out of version control in real
# deployments (set it in your host's env vars, not this file) — anyone who
# knows it can reach the login page. Auth still gates everything behind it.
ADMIN_PATH=/admin-panel
# Session cookie lifetime, in hours.
SESSION_TTL_HOURS=168
# Failed-login lockout: attempts allowed before a temporary lock, and the
# lock duration in seconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ---- Public ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show the live Theme Studio panel in production (it is always on in dev).
NEXT_PUBLIC_THEME_STUDIO=false

# ---- Contact form ----------------------------------------------------------
# MAIL_PROVIDER: console | smtp | resend | webhook
MAIL_PROVIDER=console

# smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=app_password_here
MAIL_FROM="Portfolio" <you@example.com>
MAIL_TO=you@example.com

# resend
RESEND_API_KEY=

# webhook (Slack/Discord/n8n/whatever)
CONTACT_WEBHOOK_URL=

# ---- Abuse control ---------------------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
